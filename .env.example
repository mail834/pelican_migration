# Server-only values. Copy to .env.local and configure these in your hosting platform.
# Enquiry email over SMTP (Google Workspace for pelicanmigration.com). Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mail@pelicanmigration.com
# A Google App Password (myaccount.google.com/apppasswords), not the account password.
SMTP_PASS=
# Gmail sends as SMTP_USER unless another address is set up under "Send mail as".
ENQUIRY_FROM_EMAIL=Pelican Immigration <mail@pelicanmigration.com>
ENQUIRY_TO_EMAIL=mail@pelicanmigration.com
# Visitors get an automatic "we've received your enquiry" email. Set to off to disable.
ENQUIRY_ACKNOWLEDGEMENT=on
# Optional canonical origin for reverse proxies, e.g. https://www.example.com
SITE_ORIGIN=

# HTTPS endpoint that accepts newsletter subscriptions (see docs/INTEGRATIONS.md).
NEWSLETTER_WEBHOOK_URL=
# Optional bearer token checked by the receiving webhook.
NEWSLETTER_WEBHOOK_SECRET=

# Abuse protection for /api/enquiries and /api/newsletter (see docs/INTEGRATIONS.md).
# Shared rate limit across serverless instances (Upstash Redis REST; Vercel KV's KV_REST_API_* also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile. Set BOTH or neither: the site key is public, the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanity CMS (server-side published content)
SANITY_PROJECT_ID=th8gmrhr
SANITY_DATASET=production
# Required: the production dataset is private. Create a Viewer token in
# sanity.io/manage → API → Tokens. Server-only; never expose it to the browser.
SANITY_API_READ_TOKEN=
# Use the same strong random secret in the Sanity GROQ webhook settings.
SANITY_REVALIDATE_SECRET=
# Sanity-hosted editor, e.g. https://pelican-immigration.sanity.studio. When set, /studio redirects there.
SANITY_STUDIO_URL=https://pelican-migration.sanity.studio

# Optional Cloudflare edge cache for Sanity images (docs/SANITY.md → Cloudflare image cache).
# Set only after img.pelicanmigration.ae is deployed; leave blank to load images from cdn.sanity.io.
NEXT_PUBLIC_IMAGE_CDN=
